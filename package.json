    "generate-icons": "NODE_OPTIONS=\"--max-old-space-size=8192\" tsx tools/generate-icons/index.ts",
    "update-reference": "NODE_OPTIONS=\"--max-old-space-size=8192\" tsx tools/generate-icons/index.ts --reference-only",
    "update-references": "NX_DAEMON=false NODE_OPTIONS=\"--max-old-space-size=5120\" nx run-many --target=update-reference",
    "build-icons": "ulimit -n 65536 && NX_DAEMON=false NODE_OPTIONS=\"--max-old-space-size=5120\" nx run-many --target=build",
    "generate-all-icons": "ulimit -n 65536 && NX_DAEMON=false NODE_OPTIONS=\"--max-old-space-size=5120\" nx run-many --target=generate-icons",
    "scaffold-all-icon-libraries": "NODE_OPTIONS=\"--max-old-space-size=8192\" tsx tools/generate-all-icon-libraries/index.ts"
  },
