{
  "name": "uix-sharp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/uix-sharp/src",
  "prefix": "uix-sharp",
  "tags": [],
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/uix-sharp/ng-package.json",
        "tsConfig": "packages/uix-sharp/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/uix-sharp/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production",
      "dependsOn": ["generate-icons", "generate-icons"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      },
      "dependsOn": ["build", "build"]
    },
    "update-reference": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/node_modules/@iconify/json/package.json",
        "{workspaceRoot}/node_modules/@iconify/json/json/uix-sharp.json"
      ],
      "outputs": ["{projectRoot}/icon-set.json"],
      "options": {
        "command": "tsx tools/generate-icons/index.ts uix-sharp --reference-only",
        "cwd": "{workspaceRoot}"
      }
    },
    "generate-icons": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["update-reference"],
      "inputs": [
        "{projectRoot}/icon-set.json",
        "{workspaceRoot}/tools/generate-icons/**/*",
        "{workspaceRoot}/tools/workspace-plugin/generators/icon-library/lib/**/*",
        "{projectRoot}/meta.json"
      ],
      "outputs": [
        "{projectRoot}/n3/src/lib/icons",
        "{projectRoot}/a/src/lib/icons",
        "{projectRoot}/b/src/lib/icons",
        "{projectRoot}/c/src/lib/icons",
        "{projectRoot}/d/src/lib/icons",
        "{projectRoot}/e/src/lib/icons",
        "{projectRoot}/f/src/lib/icons",
        "{projectRoot}/g/src/lib/icons",
        "{projectRoot}/h/src/lib/icons",
        "{projectRoot}/i/src/lib/icons",
        "{projectRoot}/j/src/lib/icons",
        "{projectRoot}/k/src/lib/icons",
        "{projectRoot}/l/src/lib/icons",
        "{projectRoot}/m/src/lib/icons",
        "{projectRoot}/n/src/lib/icons",
        "{projectRoot}/o/src/lib/icons",
        "{projectRoot}/p/src/lib/icons",
        "{projectRoot}/q/src/lib/icons",
        "{projectRoot}/r/src/lib/icons",
        "{projectRoot}/s/src/lib/icons",
        "{projectRoot}/t/src/lib/icons",
        "{projectRoot}/u/src/lib/icons",
        "{projectRoot}/v/src/lib/icons",
        "{projectRoot}/w/src/lib/icons",
        "{projectRoot}/x/src/lib/icons",
        "{projectRoot}/y/src/lib/icons",
        "{projectRoot}/z/src/lib/icons",
        "{projectRoot}/README.md"
      ],
      "options": {
        "command": "ulimit -n 65536 && NODE_OPTIONS=\"--max-old-space-size=8192\" tsx tools/generate-icons/index.ts uix-sharp",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
