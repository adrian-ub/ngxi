{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "10-filled/src/**/*.ts",
    "12-filled/src/**/*.ts",
    "16-filled/src/**/*.ts",
    "20-filled/src/**/*.ts",
    "24-filled/src/**/*.ts",
    "28-filled/src/**/*.ts",
    "32-filled/src/**/*.ts",
    "48-filled/src/**/*.ts",
    "light/src/**/*.ts",
    "10-regular/src/**/*.ts",
    "12-regular/src/**/*.ts",
    "16-regular/src/**/*.ts",
    "20-regular/src/**/*.ts",
    "24-regular/src/**/*.ts",
    "28-regular/src/**/*.ts",
    "32-regular/src/**/*.ts",
    "48-regular/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "10-filled/src/**/*.spec.ts",
    "12-filled/src/**/*.spec.ts",
    "16-filled/src/**/*.spec.ts",
    "20-filled/src/**/*.spec.ts",
    "24-filled/src/**/*.spec.ts",
    "28-filled/src/**/*.spec.ts",
    "32-filled/src/**/*.spec.ts",
    "48-filled/src/**/*.spec.ts",
    "light/src/**/*.spec.ts",
    "10-regular/src/**/*.spec.ts",
    "12-regular/src/**/*.spec.ts",
    "16-regular/src/**/*.spec.ts",
    "20-regular/src/**/*.spec.ts",
    "24-regular/src/**/*.spec.ts",
    "28-regular/src/**/*.spec.ts",
    "32-regular/src/**/*.spec.ts",
    "48-regular/src/**/*.spec.ts",
    "10-filled/src/**/*.test.ts",
    "12-filled/src/**/*.test.ts",
    "16-filled/src/**/*.test.ts",
    "20-filled/src/**/*.test.ts",
    "24-filled/src/**/*.test.ts",
    "28-filled/src/**/*.test.ts",
    "32-filled/src/**/*.test.ts",
    "48-filled/src/**/*.test.ts",
    "light/src/**/*.test.ts",
    "10-regular/src/**/*.test.ts",
    "12-regular/src/**/*.test.ts",
    "16-regular/src/**/*.test.ts",
    "20-regular/src/**/*.test.ts",
    "24-regular/src/**/*.test.ts",
    "28-regular/src/**/*.test.ts",
    "32-regular/src/**/*.test.ts",
    "48-regular/src/**/*.test.ts"
  ]
}
