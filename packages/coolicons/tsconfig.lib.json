{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "bulk/src/**/*.ts",
    "bulk-round/src/**/*.ts",
    "bulk-sharp/src/**/*.ts",
    "duocolor/src/**/*.ts",
    "duocolor-round/src/**/*.ts",
    "duocolor-sharp/src/**/*.ts",
    "duotone/src/**/*.ts",
    "duotone-round/src/**/*.ts",
    "duotone-sharp/src/**/*.ts",
    "fill/src/**/*.ts",
    "fill-round/src/**/*.ts",
    "fill-sharp/src/**/*.ts",
    "round/src/**/*.ts",
    "sharp/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "bulk/src/**/*.spec.ts",
    "bulk/src/**/*.test.ts",
    "bulk-round/src/**/*.spec.ts",
    "bulk-round/src/**/*.test.ts",
    "bulk-sharp/src/**/*.spec.ts",
    "bulk-sharp/src/**/*.test.ts",
    "duocolor/src/**/*.spec.ts",
    "duocolor/src/**/*.test.ts",
    "duocolor-round/src/**/*.spec.ts",
    "duocolor-round/src/**/*.test.ts",
    "duocolor-sharp/src/**/*.spec.ts",
    "duocolor-sharp/src/**/*.test.ts",
    "duotone/src/**/*.spec.ts",
    "duotone/src/**/*.test.ts",
    "duotone-round/src/**/*.spec.ts",
    "duotone-round/src/**/*.test.ts",
    "duotone-sharp/src/**/*.spec.ts",
    "duotone-sharp/src/**/*.test.ts",
    "fill/src/**/*.spec.ts",
    "fill/src/**/*.test.ts",
    "fill-round/src/**/*.spec.ts",
    "fill-round/src/**/*.test.ts",
    "fill-sharp/src/**/*.spec.ts",
    "fill-sharp/src/**/*.test.ts",
    "round/src/**/*.spec.ts",
    "round/src/**/*.test.ts",
    "sharp/src/**/*.spec.ts",
    "sharp/src/**/*.test.ts"
  ]
}
